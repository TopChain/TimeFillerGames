{
  "name": "timefillergames",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "server:release:check": "node scripts/validate-server-release-env.mjs",
    "release:preflight": "npm run server:release:check && npm run check && npm run mobile:release:build",
    "staging:smoke": "node scripts/smoke-staging.mjs",
    "staging:load": "node scripts/load-room.mjs",
    "staging:e2e": "node scripts/e2e-staging.mjs",
    "mobile:dev": "vite --config mobile/build.config.ts",
    "mobile:build": "vite build --config mobile/build.config.ts",
    "mobile:release:check": "node scripts/validate-mobile-release-env.mjs",
    "mobile:release:build": "npm run mobile:release:check && npm run mobile:build",
    "mobile:init": "npm run mobile:build && cap add ios && cap add android && node scripts/configure-native-release.mjs",
    "mobile:sync": "npm run mobile:build && cap sync && node scripts/configure-native-release.mjs",
    "mobile:configure-native": "node scripts/configure-native-release.mjs",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android"
  },
  "engines": { "node": ">=20.9.0" },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^3.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.57.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
