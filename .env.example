NEXT_PUBLIC_SUPABASE_URL=
# Preferred current browser key. Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported during migration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred current server secret. Legacy SUPABASE_SERVICE_ROLE_KEY is also supported during migration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS web origin used in room links and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave blank for same-origin web. Native builds set their own VITE_API_BASE_URL to the hosted HTTPS origin.
NEXT_PUBLIC_API_BASE_URL=
# Optional explicit Supabase magic-link callback. Native builds use timefillergames://auth/callback.
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# Store-review builds must set this to true so Apple/Google can use reusable demo Host
# email/password credentials supplied privately in review notes. No credentials are stored in the app.
NEXT_PUBLIC_REVIEW_ACCESS_ENABLED=false

# Test-driven operational defaults. Do not advertise these as fixed public product limits.
ROOM_CODE_LENGTH=6
ROOM_TTL_MINUTES=120
HEARTBEAT_STALE_SECONDS=35
RECONNECT_GRACE_SECONDS=60
HOST_RECOVERY_GRACE_SECONDS=45

# Configure a strong value only in the hosting provider when the retention cron endpoint is enabled.
CRON_SECRET=
